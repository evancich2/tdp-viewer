      ],
      "outcomes": {
        "raised": "nonconforming"
      },
      "roles": [
        "quality-engineer"
      ],
      "requires": {
        "actions": [],
        "evidence": [],
        "freshAuthority": false,
        "unit": true
      },
      "distinctActorFrom": [],
      "distinctOrganizationFrom": []
