{
  "name": "tdp-viewer",
  "version": "0.1.0",
  "description": "Zero-trust viewer for engineering Technical Data Packages (drawings, 3D models, BOMs)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tdp": "tsx tools/tdp.ts",
    "sample": "tsx tools/make-sample.ts",
    "e2e": "vite build && tsx tests/e2e/viewer.e2e.ts && tsx tests/e2e/pwa.e2e.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
